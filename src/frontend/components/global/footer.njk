<footer>
  <div>
    <h6>{{ site.title }}</h6>
    <p>{{ site.description }}</p>
  </div>
  <div>
    <h6>Legal</h6>
      <ul>
        <li><a href="{{ site.legal.privacy }}">Privacy Policy</a></li>
        <li><a href="{{ site.legal.cookie }}">Cookie Policy</a></li>
        <li><a href="{{ site.legal.terms }}">Terms and conditions</a></li>
      </ul>
  </div>

  <hr />

  <div class="copyright">
    <p>
      &copy; {{ site.legal.copyright.year }} {{ site.site_name }} - {{ site.legal.copyright.text }}
    </p>
  </div>
</footer>